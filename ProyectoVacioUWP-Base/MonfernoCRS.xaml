                           Source="AssetsMonfernoCRS/rasguños2.png"
                           Width="80"
                           Height="80"
                           Canvas.Left="150"
                           Canvas.Top="55"
                           Opacity="0"
                           IsHitTestVisible="False"
                           Canvas.ZIndex="80"/>

                    <Image x:Name="imgRasgunosBarriga"
                           Source="AssetsMonfernoCRS/rasguños3.png"
                           Width="55"
                           Height="55"
                           Canvas.Left="230"
                           Canvas.Top="345"
                           Opacity="0"
                           IsHitTestVisible="False"
                           Canvas.ZIndex="80"/>

                    <Image x:Name="imgRasgunosBrazo"
                           Source="AssetsMonfernoCRS/rasguños3.png"
                           Width="60"
                           Height="60"
                           Canvas.Left="320"
                           Canvas.Top="315"
                           Opacity="0"
                           IsHitTestVisible="False"
                           Canvas.ZIndex="80"/>

                    <Image x:Name="imgEffectPlacaje" 
                       Source="AssetsMonfernoCRS/placaje.png" 
                       Width="350" 
                       Height="350"
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top"
                       Margin="-150,150,0,0" 
                       Opacity="0" 
                       IsHitTestVisible="False" 
                       Canvas.ZIndex="100"/>

                    <MediaElement x:Name="soundPlacaje" Source="AssetsMonfernoCRS/Placaje.mp3" AutoPlay="False" Volume="0.5"/>
                    <MediaElement x:Name="soundLanzallamas" Source="AssetsMonfernoCRS/Lanzallamas.mp3" AutoPlay="False" Volume="0.5"/>
                    <MediaElement x:Name="soundDescansar" Source="AssetsMonfernoCRS/Sonido_curacion.mp3" AutoPlay="False" Volume="0.5"/>

