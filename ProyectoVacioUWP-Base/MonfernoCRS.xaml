<UserControl x:Class="ProyectoVacioUWP_Base.MonfernoCRS"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <Storyboard x:Name="sbAtaqueFlojo">
            <DoubleAnimation Storyboard.TargetName="MonfernoTransform"
                             Storyboard.TargetProperty="TranslateX"
                             By="-80"
                             Duration="0:0:0.15"
                             AutoReverse="True"/>

            <DoubleAnimation Storyboard.TargetName="MonfernoTransform"
                             Storyboard.TargetProperty="ScaleX"
                             To="0.95"
                             Duration="0:0:0.1"
                             AutoReverse="True"/>

            <DoubleAnimation Storyboard.TargetName="MonfernoTransform"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.05"
                             Duration="0:0:0.1"
                             AutoReverse="True"/>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="imgEffectPlacaje"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Name="sbAtaqueFuerte">
            <DoubleAnimation Storyboard.TargetName="MonfernoTransform" Storyboard.TargetProperty="TranslateY" By="-150" Duration="0:0:0.32" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="MonfernoTransform" Storyboard.TargetProperty="ScaleX" By="0.3" Duration="0:0:0.32" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="MonfernoTransform" Storyboard.TargetProperty="ScaleY" By="0.3" Duration="0:0:0.32" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="transBrazoIzq"
                 Storyboard.TargetProperty="Rotation"
                 From="0"
                 To="-65"
                 Duration="0:0:0.18"
                 AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Name="sbDescansar" RepeatBehavior="1x" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="MonfernoTransform"
                     Storyboard.TargetProperty="TranslateY"
                     To="15"
                     Duration="0:0:0.8"/>

            <DoubleAnimation Storyboard.TargetName="MonfernoTransform"
                     Storyboard.TargetProperty="ScaleY"
                     To="0.96"
                     Duration="0:0:0.8"/>

            <DoubleAnimation Storyboard.TargetName="MonfernoTransform"
                     Storyboard.TargetProperty="ScaleX"
                     To="1.03"
                     Duration="0:0:0.8"/>
        </Storyboard>

        <Storyboard x:Name="sbDescansarEnergia">

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="energiaDescanso"
                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimation Storyboard.TargetName="transEnergiaDescanso"
            Storyboard.TargetProperty="ScaleX"
            From="0.8"
            To="1"
            Duration="0:0:1"
            AutoReverse="True"
            RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="transEnergiaDescanso"
            Storyboard.TargetProperty="ScaleY"
            From="0.8"
            To="1"
            Duration="0:0:1"
            AutoReverse="True"
            RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="transEnergiaDescanso"
             Storyboard.TargetProperty="TranslateY"
             From="20"
             To="-20"
             Duration="0:0:1.5"/>

            <DoubleAnimation Storyboard.TargetName="transEnergiaDescanso"
            Storyboard.TargetProperty="Rotation"
            From="0"
            To="360"
            Duration="0:0:2"
            RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Name="sbDefensa">
            <DoubleAnimation Storyboard.TargetName="escudoVisual"
                     Storyboard.TargetProperty="Opacity"
                     To="0.65"
                     Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="escudoScale"
                     Storyboard.TargetProperty="ScaleX"
                     From="0.7"
                     To="1"
                     Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="escudoScale"
                     Storyboard.TargetProperty="ScaleY"
                     From="0.7"
                     To="1"
                     Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Name="sbQuitarDefensa">
            <DoubleAnimation Storyboard.TargetName="escudoVisual"
                     Storyboard.TargetProperty="Opacity"
                     To="0"
                     Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Name="sbIdle" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="transCuerpo" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:1.5" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="transCuerpo" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:1.5" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="transCola" Storyboard.TargetProperty="Rotation" From="-5" To="5" Duration="0:0:2" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Name="sbActivarCansado">
            <DoubleAnimation Storyboard.TargetName="sudorCansado"
                     Storyboard.TargetProperty="Opacity"
                     To="1"
                     Duration="0:0:0.3"/>

            <DoubleAnimation Storyboard.TargetName="transCola"
                     Storyboard.TargetProperty="Rotation"
                     To="55"
                     Duration="0:0:0.5"/>
        </Storyboard>

        <Storyboard x:Name="sbSudorCaida"
            RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="transSudor"
                     Storyboard.TargetProperty="TranslateY"
                     From="0"
                     To="18"
                     Duration="0:0:0.8"
                     AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Name="sbColaCansada"
            RepeatBehavior="Forever"
            AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="transCola"
                     Storyboard.TargetProperty="Rotation"
                     From="50"
                     To="58"
                     Duration="0:0:1.6"/>
        </Storyboard>

        <Storyboard x:Name="sbDesactivarCansado">
            <DoubleAnimation Storyboard.TargetName="sudorCansado"
                     Storyboard.TargetProperty="Opacity"
                     To="0"
                     Duration="0:0:0.3"/>

            <DoubleAnimation Storyboard.TargetName="transSudor"
                     Storyboard.TargetProperty="TranslateY"
                     To="0"
                     Duration="0:0:0.2"/>

            <DoubleAnimation Storyboard.TargetName="transCola"
                     Storyboard.TargetProperty="Rotation"
                     To="0"
                     Duration="0:0:0.4"/>
        </Storyboard>

        <Storyboard x:Name="sbActivarHerido">
            <DoubleAnimation Storyboard.TargetName="imgRasgunosCara"
                     Storyboard.TargetProperty="Opacity"
                     To="1"
                     Duration="0:0:0.2"/>

            <DoubleAnimation Storyboard.TargetName="imgRasgunosBarriga"
                     Storyboard.TargetProperty="Opacity"
                     To="1"
                     Duration="0:0:0.2"/>

            <DoubleAnimation Storyboard.TargetName="imgRasgunosBrazo"
                     Storyboard.TargetProperty="Opacity"
                     To="1"
                     Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Name="sbDesactivarHerido">
            <DoubleAnimation Storyboard.TargetName="imgRasgunosCara"
                     Storyboard.TargetProperty="Opacity"
                     To="0"
                     Duration="0:0:0.2"/>

            <DoubleAnimation Storyboard.TargetName="imgRasgunosBarriga"
                     Storyboard.TargetProperty="Opacity"
                     To="0"
                     Duration="0:0:0.2"/>

            <DoubleAnimation Storyboard.TargetName="imgRasgunosBrazo"
                     Storyboard.TargetProperty="Opacity"
                     To="0"
                     Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Name="sbColaHerido"
            RepeatBehavior="Forever"
            AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="transCola"
                     Storyboard.TargetProperty="Rotation"
                     From="-8"
                     To="2"
                     Duration="0:0:2.2"/>
        </Storyboard>

        <Storyboard x:Name="sbTemblorHerido"
            RepeatBehavior="Forever"
            AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="MonfernoTransform"
                     Storyboard.TargetProperty="TranslateX"
                     By="3"
                     Duration="0:0:0.18"/>
        </Storyboard>

        <Storyboard x:Name="sbDerrotado">
            <DoubleAnimation Storyboard.TargetName="MonfernoTransform"
                     Storyboard.TargetProperty="Rotation"
                     To="75"
                     Duration="0:0:0.5"/>

            <DoubleAnimation Storyboard.TargetName="MonfernoTransform"
                     Storyboard.TargetProperty="TranslateY"
                     To="140"
                     Duration="0:0:0.5"/>
        </Storyboard>

        <Storyboard x:Name="sbQuitarDerrotado">
            <DoubleAnimation Storyboard.TargetName="MonfernoTransform"
                     Storyboard.TargetProperty="Rotation"
                     To="0"
                     Duration="0:0:0.3"/>

            <DoubleAnimation Storyboard.TargetName="MonfernoTransform"
                     Storyboard.TargetProperty="TranslateY"
                     To="40"
                     Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Name="sbLlamarada">

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="llamarada"
                                   Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.10" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.70" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.95" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimation Storyboard.TargetName="transFuego"
                     Storyboard.TargetProperty="ScaleX"
                     From="0.5"
                     To="1.8"
                     Duration="0:0:0.70"/>

            <DoubleAnimation Storyboard.TargetName="transFuego"
                     Storyboard.TargetProperty="ScaleY"
                     From="0.5"
                     To="1.8"
                     Duration="0:0:0.70"/>

            <DoubleAnimation Storyboard.TargetName="transFuego"
                     Storyboard.TargetProperty="TranslateX"
                     From="0"
                     To="-120"
                     Duration="0:0:0.70"/>
        </Storyboard>

    </UserControl.Resources>

    <Grid>

        <Image x:Name="imgFondo" Source="AssetsMonfernoCRS/fondo.png" Stretch="UniformToFill"/>

        <Viewbox Stretch="Uniform">
            <Grid Width="1280" Height="720">


                <Image x:Name="energiaDescanso"
                               Source="AssetsMonfernoCRS/energia_recuperacion.png"
                               Width="520"
                               Height="520"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="500,110,0,0"
                               Opacity="0"
                               IsHitTestVisible="False"
                               Canvas.ZIndex="5"
                               RenderTransformOrigin="0.5,0.5">

                    <Image.RenderTransform>
                        <CompositeTransform x:Name="transEnergiaDescanso"
                                                    ScaleX="0.85"
                                                    ScaleY="0.85"
                                                    TranslateY="0"/>
                    </Image.RenderTransform>

                </Image>

                <Canvas x:Name="MonfernoCanvas"
                        Margin="390,95,386,115"
                        Background="Transparent"
                        RenderTransformOrigin="0.5,0.5"
                        ManipulationMode="TranslateX,TranslateY,Scale"
                        ManipulationDelta="MonfernoCanvas_ManipulationDelta">

                    <Canvas.RenderTransform>
                        <CompositeTransform x:Name="MonfernoTransform" TranslateX="120" TranslateY="40" ScaleX="1" ScaleY="1"/>
                    </Canvas.RenderTransform>

                    <Grid x:Name="escudoVisual"
                            Width="600"
                            Height="600"
                            Opacity="0"
                            Canvas.Left="-60"
                            Canvas.Top="-60"
                            Canvas.ZIndex="999"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.5,0.5">

                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="escudoScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <Ellipse Fill="#3300BFFF"
                                Stroke="Cyan"
                                StrokeThickness="14"/>
                    </Grid>

