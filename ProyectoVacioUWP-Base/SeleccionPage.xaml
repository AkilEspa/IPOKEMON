<Page
    x:Class="ProyectoVacioUWP_Base.SeleccionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#1A1B26">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Previsualización J1 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="10">
                <TextBlock x:Name="txtNombreJ1" FontSize="32" Foreground="Cyan" HorizontalAlignment="Center" FontWeight="Bold"/>
                <Border x:Name="BordePreviaJ1" BorderBrush="Cyan" BorderThickness="3" CornerRadius="15" Margin="15" Height="400" Background="#2A2F45">
                    <ContentControl x:Name="ContenedorJ1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Border>
                <TextBlock x:Name="txtEstadoJ1" Text="J1: ELIGIENDO..." Foreground="White" HorizontalAlignment="Center" FontSize="18"/>
            </StackPanel>

            <!-- Panel Central: El Diamante (Protegido con Viewbox para que no se mueva) -->
            <Viewbox Grid.Column="1" MaxHeight="600" Margin="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <ItemsControl x:Name="Fila1" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl x:Name="Fila2" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl x:Name="Fila3" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl x:Name="Fila4" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl x:Name="Fila5" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Viewbox>

            <!-- Previsualización J2 -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10">
                <TextBlock x:Name="txtNombreJ2" FontSize="32" Foreground="Red" HorizontalAlignment="Center" FontWeight="Bold"/>
                <Border x:Name="BordePreviaJ2" BorderBrush="Red" BorderThickness="3" CornerRadius="15" Margin="15" Height="400" Background="#2A2F45">
                    <ContentControl x:Name="ContenedorJ2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Border>
                <TextBlock x:Name="txtEstadoJ2" Text="J2: ELIGIENDO..." Foreground="White" HorizontalAlignment="Center" FontSize="18"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Background="#0F111A" Padding="15,20">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptabilidadControles">
                    <!-- ESTADO VERTICAL: Se activa cuando la ventana es estrecha para evitar que los textos choquen -->
                    <VisualState x:Name="EstadoEstrecho">
                        <VisualState.StateTriggers>
                            <!-- He subido el valor a 1050px aprox. para que cambie ANTES de que lleguen a chocar -->
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ContenedorVertical.Orientation" Value="Vertical"/>
                            <Setter Target="txtP1.Margin" Value="0,0,0,10"/>
                            <!-- Quitamos el alineado lateral para centrar en vertical -->
                            <Setter Target="txtP1.HorizontalAlignment" Value="Center"/>
                            <Setter Target="txtP2.HorizontalAlignment" Value="Center"/>
                        </VisualState.Setters>
                    </VisualState>

                    <!-- ESTADO HORIZONTAL: Cada uno bajo su personaje -->
                    <VisualState x:Name="EstadoAncho">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1050" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ContenedorVertical.Orientation" Value="Horizontal"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Usamos un StackPanel dentro de un Grid para controlar la posición exacta -->
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- El StackPanel central abarca todo pero sus hijos se alinean a los extremos -->
                <StackPanel x:Name="ContenedorVertical" Grid.ColumnSpan="3" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">

                    <!-- Texto P1: Alineado a la izquierda (bajo J1) en modo ancho -->
                    <TextBlock x:Name="txtP1" Text="P1: [W-A-S-D] + ESPACIO" 
                       Foreground="Cyan" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Left" Margin="40,0"/>

                    <!-- Texto P2: Alineado a la derecha (bajo J2) en modo ancho -->
                    <TextBlock x:Name="txtP2" Text="P2: [FLECHAS] + ENTER" 
                       Foreground="Red" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Right" Margin="40,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>