<UserControl
    x:Class="ProyectoVacioUWP_Base.PsyduckADM"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProyectoVacioUWP_Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <UserControl.Resources>

        <Storyboard x:Name="AniIdle" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation From="1" To="1.02" Duration="00:00:01.5" Storyboard.TargetName="CuerpoSom" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"/>
            <DoubleAnimation From="1" To="1.02" Duration="00:00:01.5" Storyboard.TargetName="CuerpoSom" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"/>
        </Storyboard>

        <Storyboard x:Name="AniAtaqueDebil" AutoReverse="True">
            <PointAnimationUsingKeyFrames EnableDependentAnimation="True" Storyboard.TargetName="brazo_der" Storyboard.TargetProperty="(UIElement.RenderTransformOrigin)">
                <EasingPointKeyFrame KeyTime="00:00:00.5000000" Value="0.451,0.744"/>
            </PointAnimationUsingKeyFrames>
            <DoubleAnimation Duration="00:00:00.5000000" Storyboard.TargetName="brazo_der" To="-2.03" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"/>
            <DoubleAnimation Duration="00:00:00.5000000" Storyboard.TargetName="brazo_der" To="13.985" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"/>
            <DoubleAnimation Duration="00:00:00.5000000" Storyboard.TargetName="brazo_der" To="-77.728" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"/>
        </Storyboard>

        <Storyboard x:Name="AniAtaqueFuerte" AutoReverse="True">
            <ColorAnimation Duration="00:00:01" Storyboard.TargetName="Ojo_izq" To="#FFC198F4" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" BeginTime="00:00:00.5000000"/>
            <ColorAnimation Duration="00:00:01" Storyboard.TargetName="Ojo_der" To="#FFC198F4" Storyboard.TargetProperty="(FrameworkElement.FocusVisualPrimaryBrush).(SolidColorBrush.Color)"/>
            <ColorAnimation Duration="00:00:01" Storyboard.TargetName="Ojo_der" To="#FFC198F4" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Cabeza" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="5"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.4000000" Value="-2.989"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.6000000" Value="5"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.8000000" Value="-5"/>
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Cabeza" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.4000000" Value="1.016"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Cabeza" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.4000000" Value="1.015"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Cabeza" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.4000000" Value="2.011"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Name="AniDescanso" AutoReverse="True">
            <DoubleAnimation Duration="00:00:01" Storyboard.TargetName="CuerpoSom" To="1.03" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"/>
            <DoubleAnimation Duration="00:00:01" Storyboard.TargetName="CuerpoSom" To="1" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"/>
            <DoubleAnimation Duration="00:00:01" Storyboard.TargetName="Ojo_izq" To="0.1" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"/>
            <DoubleAnimation Duration="00:00:01" Storyboard.TargetName="Ojo_der" To="0.1" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"/>
        </Storyboard>

        <Storyboard x:Name="EstHerido" AutoReverse="False">
            <ColorAnimation Duration="00:00:00.5000000" Storyboard.TargetName="Cuerpo" To="#FFED8857" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"/>
            <ColorAnimation Duration="00:00:00.5000000" Storyboard.TargetName="ellipse" To="#FFED8857" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"/>
            <DoubleAnimation Duration="00:00:00.5000000" Storyboard.TargetName="Ojo_der" To="0" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"/>
            <DoubleAnimation Duration="00:00:00.5000000" Storyboard.TargetName="Ojo_der" To="0.7" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"/>
            <DoubleAnimation Duration="00:00:00.5000000" Storyboard.TargetName="Ojo_izq" To="0.7" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"/>
        </Storyboard>

        <Storyboard x:Name="EstCansado" AutoReverse="False">
            <DoubleAnimation Duration="00:00:00" Storyboard.TargetName="Ojo_izq" To="0.5" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"/>
            <DoubleAnimation Duration="00:00:00" Storyboard.TargetName="Ojo_der" To="0.5" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"/>
            <DoubleAnimation Duration="00:00:01.5000000" Storyboard.TargetName="Cabeza" To="10" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"/>
            <DoubleAnimation Duration="00:00:01.5000000" Storyboard.TargetName="Psyduck" To="0.57" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"/>
            <DoubleAnimation Duration="00:00:00" Storyboard.TargetName="sombra_clara_pie_izq" To="9.049" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"/>
            <DoubleAnimation Duration="00:00:00" Storyboard.TargetName="sombra_clara_pie_izq" To="21.869" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"/>
        </Storyboard>

        <Storyboard x:Name="AniDefensa" AutoReverse="True" RepeatBehavior="3x">
            <DoubleAnimation From="0" To="0.6" Duration="00:00:00.2" Storyboard.TargetName="Escudo" Storyboard.TargetProperty="Opacity"/>
            <DoubleAnimation Duration="00:00:00.2" Storyboard.TargetName="Ojo_izq" To="0.6" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"/>
            <DoubleAnimation Duration="00:00:00.2" Storyboard.TargetName="Ojo_der" To="0.6" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"/>
        </Storyboard>

        <Storyboard x:Name="EstEscudo" AutoReverse="False">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Escudo" Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0.4"/>
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="0.2"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Name="EstDerrotado" AutoReverse="True">
            <DoubleAnimation Duration="00:00:00.5000000" Storyboard.TargetName="Ojo_izq" To="0.1" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"/>
            <DoubleAnimation Duration="00:00:00.5000000" Storyboard.TargetName="Ojo_der" To="0.2" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"/>
            <DoubleAnimation Duration="00:00:01" Storyboard.TargetName="Psyduck" To="90" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"/>
            <DoubleAnimation Duration="00:00:01" Storyboard.TargetName="Psyduck" To="10" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"/>
            <DoubleAnimation Duration="00:00:01" Storyboard.TargetName="Psyduck" To="0.7" Storyboard.TargetProperty="(UIElement.Opacity)"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="imFondo" Source="AssetsPsyduckADM/fondonuevo.png" Stretch="UniformToFill" 
               Grid.RowSpan="4" Grid.ColumnSpan="3" Margin="-24,-4,1,-3"/>

        <Image x:Name="imCorazon" Grid.Row="0" Grid.Column="0" Source="AssetsPsyduckADM/corazon.png" Margin="5"/>
        <ProgressBar x:Name="pbHealth" Grid.Row="0" Grid.Column="1" Value="50" Maximum="100" 
                     Foreground="Red" VerticalAlignment="Center" Height="20" Margin="5,0"/>
        <Image x:Name="imRedPotion" Grid.Row="0" Grid.Column="2" Source="AssetsPsyduckADM/red-potion.png" 
               Margin="5" PointerPressed="useRedPotion"/>

        <Image x:Name="imRayo" Grid.Row="1" Grid.Column="0" Source="AssetsPsyduckADM/energia.png" Margin="5"/>
        <ProgressBar x:Name="pbEnergy" Grid.Row="1" Grid.Column="1" Value="100" Maximum="100" 
                     Foreground="Yellow" VerticalAlignment="Center" Height="20" Margin="5,0"/>
        <Image x:Name="imYellowPotion" Grid.Row="1" Grid.Column="2" Source="AssetsPsyduckADM/yellow-potion.png" 
               Margin="5"/>

        <Viewbox Grid.Row="2" Grid.Column="1" Margin="10">
            <Canvas x:Name="Psyduck" Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">

                <Canvas.RenderTransform>
                    <CompositeTransform CenterX="250" CenterY="300" ScaleX="0.6" ScaleY="0.6"/>
                </Canvas.RenderTransform>

