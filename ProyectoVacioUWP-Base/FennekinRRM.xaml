<UserControl
    x:Class="ProyectoVacioUWP_Base.FennekinRRM"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProyectoVacioUWP_Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <UserControl.Resources>
        <Storyboard x:Name="AniIdle">
            <DoubleAnimation Storyboard.TargetName="cvCola"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="0" To="15" Duration="0:0:1.5" RepeatBehavior="Forever" AutoReverse="True" />

            <DoubleAnimation Storyboard.TargetName="cvCuerpo"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                             From="1" To="1.04" Duration="0:0:1.5" RepeatBehavior="Forever" AutoReverse="True" />

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="cvOjoDer"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                                           RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.5" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="0.1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.7" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.0" Value="1"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="cvOjoIzq"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                                           RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.5" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="0.1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.7" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.0" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>


        <Storyboard x:Name="AniCansado">
            <DoubleAnimation Storyboard.TargetName="cvOrejaDer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             To="35" Duration="0:0:0.5" />

            <DoubleAnimation Storyboard.TargetName="cvOrejaDer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                             To="0.9" Duration="0:0:0.5" />

            <DoubleAnimation Storyboard.TargetName="cvOrejaIzq"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             To="-20" Duration="0:0:0.5" />

            <DoubleAnimation Storyboard.TargetName="cvOrejaIzq"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                             To="0.8" Duration="0:0:0.5" />

            <DoubleAnimation Storyboard.TargetName="cvCola"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             To="-20" Duration="0:0:0.5" />

            <DoubleAnimation Storyboard.TargetName="cvOjoDer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                             To="0.6" Duration="0:0:0.5" />

            <DoubleAnimation Storyboard.TargetName="cvOjoIzq"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                             To="0.7" Duration="0:0:0.5" />

            <DoubleAnimation Storyboard.TargetName="pBoca" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
                             To="-0.3" Duration="0:0:0.3" />

            <DoubleAnimation Storyboard.TargetName="cvCabezaEntera" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                             To="12" Duration="0:0:0.5" />
        </Storyboard>


        <Storyboard x:Name="AniHeridoBucle">
            <DoubleAnimation Storyboard.TargetName="grFennekin"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                             From="-1.5" To="1.5" Duration="0:0:0.08" 
                             RepeatBehavior="Forever" AutoReverse="True" />

            <DoubleAnimation Storyboard.TargetName="cvOrejaDer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="30" To="35" Duration="0:0:1.5" 
                             RepeatBehavior="Forever" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="cvOrejaIzq"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="-30" To="-35" Duration="0:0:1.5" 
                             RepeatBehavior="Forever" AutoReverse="True" />
        </Storyboard>


        <Storyboard x:Name="AniHeridoEstatico">
            <DoubleAnimation Storyboard.TargetName="pBoca" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
                             To="-0.3" Duration="0:0:0.3" />

            <DoubleAnimation Storyboard.TargetName="cvOjoDer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                             To="0.6" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="cvOjoIzq"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                             To="0.7" Duration="0:0:0.5" />

            <DoubleAnimation Storyboard.TargetName="cvCola"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             To="-20" Duration="0:0:0.5" />

            <ColorAnimation Storyboard.TargetName="pOjoDer_Borde"
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                            To="#FF7A2982" Duration="0:0:0.5" />
        </Storyboard>


        <Storyboard x:Name="AniRestaurar">
            <DoubleAnimation Storyboard.TargetName="grFennekin" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)" To="0" Duration="0:0:0.1" />
            <DoubleAnimation Storyboard.TargetName="cvCabezaEntera" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" To="0" Duration="0:0:0.3" />

            <DoubleAnimation Storyboard.TargetName="cvOrejaDer" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" To="0" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetName="cvOrejaIzq" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" To="0" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetName="cvCola" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" To="0" Duration="0:0:0.3" />

            <DoubleAnimation Storyboard.TargetName="cvOrejaDer" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" To="1" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="cvOrejaIzq" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" To="1" Duration="0:0:0.5" />

            <DoubleAnimation Storyboard.TargetName="cvOjoDer" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" To="1" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="cvOjoIzq" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" To="1" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="pBoca" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" To="1" Duration="0:0:0.2" />

            <ColorAnimation Storyboard.TargetName="pOjoDer_Borde" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#FFFEFFFD" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="cvCabezaEntera" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" To="0" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetName="cvCuerpo" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" To="1" Duration="0:0:0.3" />

            <DoubleAnimation Storyboard.TargetName="cvOjoDer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="cvOjoIzq" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="pBoca" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />

            <DoubleAnimation Storyboard.TargetName="imOjoMuertoDer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="imOjoMuertoIzq" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
        </Storyboard>


        <Storyboard x:Name="AniAtaqueFlojo">
            <DoubleAnimation Storyboard.TargetName="grFennekin"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                             From="0" To="150" Duration="0:0:0.2" AutoReverse="True" />

            <DoubleAnimation Storyboard.TargetName="cvCabezaEntera"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="0" To="15" Duration="0:0:0.2" AutoReverse="True" />
        </Storyboard>


        <Storyboard x:Name="AniAtaqueFuerte">
            <DoubleAnimation Storyboard.TargetName="cvOrejaDer" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                             To="35" Duration="0:0:0.4" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="cvOrejaIzq" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                             To="-35" Duration="0:0:0.4" AutoReverse="True" />

            <DoubleAnimation Storyboard.TargetName="cvCabezaEntera" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)" 
                             To="1.05" Duration="0:0:0.4" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="cvCabezaEntera" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
                             To="1.05" Duration="0:0:0.4" AutoReverse="True" />

            <DoubleAnimation Storyboard.TargetName="cvCola" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                             To="-35" Duration="0:0:0.4" AutoReverse="True" />

            <DoubleAnimation Storyboard.TargetName="pBoca"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
                             To="-0.8" Duration="0:0:0.5" AutoReverse="True" />

            <ColorAnimation Storyboard.TargetName="pOjoDer_Iris" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="Red" Duration="0:0:0.6" AutoReverse="True" />
            <ColorAnimation Storyboard.TargetName="pOjoIzq_Iris" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="Red" Duration="0:0:0.6" AutoReverse="True" />

            <ColorAnimation Storyboard.TargetName="pOrejaIzq_Pelo" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="Red" Duration="0:0:0.6" AutoReverse="True" />
            <ColorAnimation Storyboard.TargetName="pOrejaIzq_Pelo1" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="Red" Duration="0:0:0.6" AutoReverse="True" />
            <ColorAnimation Storyboard.TargetName="pOrejaIzq_Pelo2" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="Red" Duration="0:0:0.6" AutoReverse="True" />

            <ColorAnimation Storyboard.TargetName="pOrejaDer_Pelo" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="Red" Duration="0:0:0.6" AutoReverse="True" />
            <ColorAnimation Storyboard.TargetName="pOrejaDer_Pelo1" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="Red" Duration="0:0:0.6" AutoReverse="True" />
            <ColorAnimation Storyboard.TargetName="pOrejaDer_Pelo2" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="Red" Duration="0:0:0.6" AutoReverse="True" />
            <ColorAnimation Storyboard.TargetName="pOrejaDer_Pelo3" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="Red" Duration="0:0:0.6" AutoReverse="True" />


            <ColorAnimation Storyboard.TargetName="pOjoDer_Borde" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="#FFFFC4C4" Duration="0:0:0.6" AutoReverse="True" />
            <ColorAnimation Storyboard.TargetName="pOjoIzq_Borde" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="#FFFFC4C4" Duration="0:0:0.6" AutoReverse="True" />

            <ColorAnimation Storyboard.TargetName="pColaRoja" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="Red" Duration="0:0:0.6" AutoReverse="True" />

            <DoubleAnimation Storyboard.TargetName="imgLlama" 
                             Storyboard.TargetProperty="Opacity" 
                             To="100" Duration="0:0:0.35" AutoReverse="True" />

            <DoubleAnimation Storyboard.TargetName="imgLlama" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)" 
                             To="1.5" Duration="0:0:0.65" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="imgLlama" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
                             To="1.5" Duration="0:0:0.65" AutoReverse="True" />
        </Storyboard>

        <Storyboard x:Name="AniDefensa">
            <DoubleAnimation Storyboard.TargetName="cvCuerpo" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
                             To="0.9" Duration="0:0:0.2" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="cvCabezaEntera" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" 
                             To="15" Duration="0:0:0.2" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="cvOrejaDer" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                             To="20" Duration="0:0:0.2" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="cvOrejaIzq" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                             To="-20" Duration="0:0:0.2" AutoReverse="True" />

            <DoubleAnimation Storyboard.TargetName="imEscudo" 
                             Storyboard.TargetProperty="Opacity" 
                             To="0.8" Duration="0:0:0.3" />

            <DoubleAnimation Storyboard.TargetName="imEscudo" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)" 
                             To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <BounceEase Bounces="2" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="imEscudo" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
                             To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <BounceEase Bounces="2" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="AniQuitarEscudo">
            <DoubleAnimation Storyboard.TargetName="imEscudo" 
                             Storyboard.TargetProperty="Opacity" 
                             To="0" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetName="imEscudo" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)" 
                             To="1.2" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetName="imEscudo" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
                             To="1.2" Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Name="AniDescansar">
            <DoubleAnimation Storyboard.TargetName="cvOjoDer" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
                             To="0.05" Duration="0:0:1.5" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="cvOjoIzq" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
                             To="0.05" Duration="0:0:1.5" AutoReverse="True" />

            <DoubleAnimation Storyboard.TargetName="cvCabezaEntera" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                             To="15" Duration="0:0:1.5" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="cvOrejaDer" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                             To="35" Duration="0:0:1.5" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="cvOrejaIzq" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                             To="-35" Duration="0:0:1.5" AutoReverse="True" />

            <DoubleAnimation Storyboard.TargetName="elCuracion" 
                             Storyboard.TargetProperty="Opacity" 
                             To="0.8" Duration="0:0:1.5" AutoReverse="True" />

            <DoubleAnimation Storyboard.TargetName="elCuracion" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)" 
                             To="1.8" Duration="0:0:3.0" />
            <DoubleAnimation Storyboard.TargetName="elCuracion" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
                             To="1.8" Duration="0:0:3.0" />
        </Storyboard>

        <Storyboard x:Name="AniDerrotado">
            <DoubleAnimation Storyboard.TargetName="cvCuerpo" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
                             To="0.8" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="cvCabezaEntera" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" 
                             To="35" Duration="0:0:0.5" />

            <DoubleAnimation Storyboard.TargetName="cvOrejaDer" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                             To="80" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="cvOrejaIzq" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                             To="-70" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="cvCola" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                             To="25" Duration="0:0:0.5" />

            <DoubleAnimation Storyboard.TargetName="cvOjoDer" 
                             Storyboard.TargetProperty="Opacity" 
                             To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="cvOjoIzq" 
                             Storyboard.TargetProperty="Opacity" 
                             To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="pBoca" 
                             Storyboard.TargetProperty="Opacity" 
                             To="0" Duration="0:0:0.2" />

            <DoubleAnimation Storyboard.TargetName="imOjoMuertoDer" 
                             Storyboard.TargetProperty="Opacity" 
                             To="1" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="imOjoMuertoIzq" 
                             Storyboard.TargetProperty="Opacity" 
                             To="1" Duration="0:0:0.2" />

            <DoubleAnimation Storyboard.TargetName="imOjoMuertoDer" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" From="0" 
                             To="360" Duration="0:0:1.5" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="imOjoMuertoIzq" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" From="0" 
                             To="360" Duration="0:0:1.5" RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>



    <Grid>
        <Grid.Background>
            <ImageBrush x:Name="imgFondoBrush" ImageSource="/AssetsFennekinRRM/fondo.jpg" Stretch="UniformToFill"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="imHeart" Source="AssetsFennekinRRM/corazon.png" Grid.Row="0" Grid.Column="0" Margin="5"/>

        <ProgressBar x:Name="pbHealth" Value="50" Maximum="100" Foreground="Red" 
                     Grid.Row="0" Grid.Column="1" Margin="5" VerticalAlignment="Stretch"/>

        <Image x:Name="imRedPotion" Source="AssetsFennekinRRM/red-potion.png" 
               Grid.Row="0" Grid.Column="2" Margin="5" 
               PointerReleased="useRedPotion"/>

        <Image x:Name="imLightning" Source="AssetsFennekinRRM/energia.png" Grid.Row="1" Grid.Column="0" Margin="5"/>

        <ProgressBar x:Name="pbEnergy" Value="50" Maximum="100" Foreground="Yellow" 
                     Grid.Row="1" Grid.Column="1" Margin="5" VerticalAlignment="Stretch"/>

        <Image x:Name="imYellowPotion" Source="AssetsFennekinRRM/yellow-potion.png" 
               Grid.Row="1" Grid.Column="2" Margin="5"
               PointerReleased="useYellowPotion"/>

        <Viewbox x:Name="vbFennekin" Grid.Row="2" Grid.Column="1" Margin="0,170,0,0">
            <Grid x:Name="grFennekin" Width="500" Height="500" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform TranslateX="0"/>
                </Grid.RenderTransform>


                <Canvas x:Name="cvCola" HorizontalAlignment="Left" Height="134" VerticalAlignment="Top" Width="122" Margin="143,326,0,0" RenderTransformOrigin="0.829,0.45">
                    <Canvas.RenderTransform>
                        <CompositeTransform Rotation="0"/>
                    </Canvas.RenderTransform>
                    <Path x:Name="pColaRoja" Height="62" Stroke="Black" Stretch="Fill" Width="64" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#FFDC552F" Data="M144.10113,325.83771 C157.02248,336.6924 189.1085,335.28823 205.99194,335.12679 191.75747,338.97273 187.91635,339.54262 182.39125,341.90694 192.45691,347.23087 200.16155,352.72891 205.90942,363.78097 189.42616,365.79394 175.27794,361.84858 163.77122,355.58178 164.6469,364.61897 164.96159,374.73441 163.98931,383.07209 157.99922,379.93179 153.29418,373.97337 149.77825,365.40723 146.12554,370.45397 144.46911,377.36305 143.77193,385.16701 144.50593,366.44539 144.77546,346.09345 144.10113,325.83771 z" />

                    <Path x:Name="pColaAmarilla" Height="125" Stroke="Black" Stretch="Fill" Width="122" HorizontalAlignment="Left" Canvas.Top="9" VerticalAlignment="Top" Fill="#FFFFE171" Data="M233.75,456.79 C182.12838,464.51592 149.23484,446.30936 142.41667,391.99668 142.52231,381.97278 144.42545,373.64924 148.39683,367.28217 151.60223,375.25117 156.94018,381.74947 162.96954,385.05806 163.59615,377.44536 164.35833,367.38594 162.99176,357.33519 175.78954,364.49025 189.93901,367.21735 205.52198,365.24849 200.19027,355.72132 192.11292,348.41224 182.06136,343.03692 191.79367,339.46477 202.00745,336.73634 207.083,336.25645 227.19724,332.96108 253.27917,340.39835 263.72869,348.47893 z" />

                </Canvas>
                <Canvas x:Name="cvCuerpo" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="178,319,0,0" Width="164" Height="170" RenderTransformOrigin="0.5,1">
                    <Canvas.RenderTransform>
