<Page
    x:Class="ProyectoVacioUWP_Base.CombatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProyectoVacioUWP_Base">

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="250" />
        </Grid.RowDefinitions>

        <!-- Área de Batalla -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="ContenedorP1" 
                            HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Margin="0,50,0,0"
                            Height="500" Width="450"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

            <ContentControl x:Name="ContenedorP2" Grid.Column="1" 
                            HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Margin="0,50,0,0"
                            Height="500" Width="450"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.RenderTransform>
                    <ScaleTransform ScaleX="-1" CenterX="225"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- Panel de Control Inferior -->
        <Grid Grid.Row="1" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Controles J1 -->
            <Border Grid.Column="0" Margin="10" Background="#25FF0000" CornerRadius="15">
                <StackPanel Padding="10">
                    <TextBlock x:Name="txtEstadoJ1" Text="ELEGIDO" Foreground="#00FF00" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtW" Grid.Row="0" Grid.Column="0" Text="[W] FLOJO" Foreground="White" Margin="5"/>
                        <TextBlock x:Name="txtA" Grid.Row="0" Grid.Column="1" Text="[A] FUERTE" Foreground="Yellow" Margin="5"/>
                        <TextBlock x:Name="txtS" Grid.Row="1" Grid.Column="0" Text="[S] ESCUDO" Foreground="Cyan" Margin="5"/>
                        <TextBlock x:Name="txtD" Grid.Row="1" Grid.Column="1" Text="[D] RELAX" Foreground="LightGreen" Margin="5"/>
                        <TextBlock x:Name="txtQ" Grid.Row="2" Grid.Column="0" Text="[Q] VIDA" Foreground="Salmon" Margin="5"/>
                        <TextBlock x:Name="txtE" Grid.Row="2" Grid.Column="1" Text="[E] ENERGIA" Foreground="Orange" Margin="5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Consola Central -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="lblNameP1" Grid.Column="0" FontSize="20" Foreground="White" TextAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="VS" Grid.Column="1" FontSize="50" FontWeight="Black" Foreground="Yellow"/>
                    <TextBlock x:Name="lblNameP2" Grid.Column="2" FontSize="20" Foreground="White" TextAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="txtConsola" Text="¡A LUCHAR!" Foreground="White" TextAlignment="Center" FontSize="16"/>
            </StackPanel>

            <!-- Controles J2 -->
            <Border Grid.Column="2" Margin="10" Background="#250000FF" CornerRadius="15">
                <StackPanel Padding="10">
                    <TextBlock x:Name="txtEstadoJ2" Text="ELEGIDO" Foreground="#00FF00" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtUp" Grid.Row="0" Grid.Column="0" Text="[↑] FLOJO" Foreground="White" Margin="5"/>
                        <TextBlock x:Name="txtLeft" Grid.Row="0" Grid.Column="1" Text="[←] FUERTE" Foreground="Yellow" Margin="5"/>
                        <TextBlock x:Name="txtDown" Grid.Row="1" Grid.Column="0" Text="[↓] ESCUDO" Foreground="Cyan" Margin="5"/>
                        <TextBlock x:Name="txtRight" Grid.Row="1" Grid.Column="1" Text="[→] RELAX" Foreground="LightGreen" Margin="5"/>
                        <TextBlock x:Name="txtO" Grid.Row="2" Grid.Column="0" Text="[O] VIDA" Foreground="Salmon" Margin="5"/>
                        <TextBlock x:Name="txtP" Grid.Row="2" Grid.Column="1" Text="[P] ENERGIA" Foreground="Orange" Margin="5"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>