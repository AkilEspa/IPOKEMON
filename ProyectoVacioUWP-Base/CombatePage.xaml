<Page
    x:Class="ProyectoVacioUWP_Base.CombatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProyectoVacioUWP_Base">

    <Grid Background="#121212">

        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>

                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PanelConsola.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Large">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="750"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PanelConsola.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Image x:Name="imgFondo"
               Grid.RowSpan="2"
               Stretch="UniformToFill"
               Opacity="0.5"/>

        <Viewbox Grid.Row="0"
                 Stretch="Uniform"
                 Margin="10">

            <Grid Width="1000"
                  Height="550">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl x:Name="ContenedorP1"
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,50,0,0"
                                Height="500"
                                Width="450"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>

                <ContentControl x:Name="ContenedorP2"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,50,0,0"
                                Height="500"
                                Width="450"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">

                    <ContentControl.RenderTransform>
                        <ScaleTransform ScaleX="-1"
                                        CenterX="225"/>
                    </ContentControl.RenderTransform>

                </ContentControl>

            </Grid>
        </Viewbox>

        <Grid x:Name="PanelInferior"
              Grid.Row="1"
              Background="#CC1E1E1E"
              BorderBrush="#333"
              BorderThickness="0,2,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="PanelJ1"
                    Grid.Column="0"
                    Margin="10"
                    Background="#25FF0000"
                    CornerRadius="15">

                <Viewbox Stretch="Uniform" Margin="5">
                    <StackPanel Padding="10">

                        <TextBlock Text="JUGADOR 1"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <Grid Margin="0,10,0,0">

                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="txtW" Grid.Row="0" Grid.Column="0" Text="[W] FLOJO" Foreground="White" Margin="5"/>
                            <TextBlock x:Name="txtA" Grid.Row="0" Grid.Column="1" Text="[A] FUERTE" Foreground="Yellow" Margin="5"/>
                            <TextBlock x:Name="txtS" Grid.Row="1" Grid.Column="0" Text="[S] ESCUDO" Foreground="Cyan" Margin="5"/>
                            <TextBlock x:Name="txtD" Grid.Row="1" Grid.Column="1" Text="[D] RELAX" Foreground="LightGreen" Margin="5"/>
                            <TextBlock x:Name="txtQ" Grid.Row="2" Grid.Column="0" Text="[Q] VIDA" Foreground="Salmon" Margin="5"/>
                            <TextBlock x:Name="txtE" Grid.Row="2" Grid.Column="1" Text="[E] ENERGIA" Foreground="Orange" Margin="5"/>

                        </Grid>
                    </StackPanel>
                </Viewbox>
            </Border>

            <StackPanel x:Name="PanelConsola"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="10,10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="lblNameP1" Grid.Column="0" FontSize="18" Foreground="White" TextAlignment="Right" Margin="0,0,10,0"/>
                    <TextBlock Text="VS" Grid.Column="1" FontSize="40" FontWeight="Black" Foreground="Yellow"/>
                    <TextBlock x:Name="lblNameP2" Grid.Column="2" FontSize="18" Foreground="White" TextAlignment="Left" Margin="10,0,0,0"/>
                </Grid>

                <TextBlock x:Name="txtConsola" Text="¡A LUCHAR!" Foreground="White" TextAlignment="Center" FontSize="16"/>
            </StackPanel>

            <Border x:Name="PanelJ2"
                    Grid.Column="2"
                    Margin="10"
                    Background="#250000FF"
                    CornerRadius="15">

                <Viewbox Stretch="Uniform" Margin="5">
                    <StackPanel Padding="10">

                        <TextBlock Text="JUGADOR 2"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <Grid Margin="0,10,0,0">

                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="txtUp" Grid.Row="0" Grid.Column="0" Text="[↑] FLOJO" Foreground="White" Margin="5"/>
                            <TextBlock x:Name="txtLeft" Grid.Row="0" Grid.Column="1" Text="[←] FUERTE" Foreground="Yellow" Margin="5"/>
                            <TextBlock x:Name="txtDown" Grid.Row="1" Grid.Column="0" Text="[↓] ESCUDO" Foreground="Cyan" Margin="5"/>
                            <TextBlock x:Name="txtRight" Grid.Row="1" Grid.Column="1" Text="[→] RELAX" Foreground="LightGreen" Margin="5"/>
                            <TextBlock x:Name="txtO" Grid.Row="2" Grid.Column="0" Text="[O] VIDA" Foreground="Salmon" Margin="5"/>
                            <TextBlock x:Name="txtP" Grid.Row="2" Grid.Column="1" Text="[P] ENERGIA" Foreground="Orange" Margin="5"/>

                        </Grid>
                    </StackPanel>
                </Viewbox>
            </Border>

        </Grid>

        <Grid x:Name="GridVictoria"
              Grid.RowSpan="2"
              Background="#F2000000"
              Visibility="Collapsed"
              Canvas.ZIndex="100">

            <Viewbox Stretch="Uniform"
                     Margin="50">

                <StackPanel Spacing="20"
                            HorizontalAlignment="Center">

                    <TextBlock Text="¡VICTORIA!"
                               Foreground="Yellow"
                               FontSize="80"
                               FontWeight="Black"
                               HorizontalAlignment="Center"/>

                    <Border Background="#2A2A2A"
                            CornerRadius="20"
                            Padding="40"
                            BorderBrush="Yellow"
                            BorderThickness="4">

                        <StackPanel>

                            <ContentControl x:Name="ContenedorGanador"
                                            Width="300"
                                            Height="300"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"/>

                            <TextBlock x:Name="txtNombreGanador"
                                       Foreground="White"
                                       FontSize="40"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,0"/>

                        </StackPanel>
                    </Border>

                    <TextBlock Text="Volviendo al menú principal..."
                               Foreground="LightGray"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>

                </StackPanel>

            </Viewbox>

        </Grid>
        <MediaPlayerElement x:Name="musicaCombate" Visibility="Collapsed" />
    </Grid>
</Page>