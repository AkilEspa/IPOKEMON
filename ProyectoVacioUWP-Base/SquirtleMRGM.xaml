                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="-10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="18"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.26" Value="0"/>
