<UserControl
    x:Class="ProyectoUWPenBlanco.UnownOVG"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProyectoUWPenBlanco"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="800">

    <UserControl.Resources>
        <Storyboard x:Name="sbIdle">
            <DoubleAnimation Storyboard.TargetName="cvUnown" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                             From="-15" To="15" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="brazo" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="-5" To="10" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="sombra_brazo" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="-5" To="10" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="pata_derecha" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="-15" To="5" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="sombra_pata_derecha" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="-15" To="5" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="brillo_pata_derecha" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="-15" To="5" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="pata_izquierda" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="5" To="-2" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="brillo_pata_izquierda" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="5" To="-2" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Name="sbHerido">
            <DoubleAnimation Storyboard.TargetName="cuerpo_rojo" Storyboard.TargetProperty="Opacity" 
                             To="0.8" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <ColorAnimation Storyboard.TargetName="scBrazo" Storyboard.TargetProperty="Color"
                            To="#FFA04040" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <ColorAnimation Storyboard.TargetName="scPataDer" Storyboard.TargetProperty="Color"
                            To="#FFA04040" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <ColorAnimation Storyboard.TargetName="scPataIzq" Storyboard.TargetProperty="Color"
                            To="#FFA04040" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <ColorAnimation Storyboard.TargetName="scCuerno" Storyboard.TargetProperty="Color"
                            To="#FFA04040" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Name="sbAtaqueFuerte">
            <DoubleAnimation Storyboard.TargetName="cvUnown" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                             From="0" To="60" Duration="0:0:0.25" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="cvUnown" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="0" To="15" Duration="0:0:0.25" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="cuerno" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="0" To="-30" Duration="0:0:0.25" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="sombra_cuerno" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="0" To="-30" Duration="0:0:0.25" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="brillo_cuerno" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="0" To="-30" Duration="0:0:0.25" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="estrella_fuerte" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.1" BeginTime="0:0:0.25" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="estrella_fuerte" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                             From="0" To="1.5" Duration="0:0:0.1" BeginTime="0:0:0.25" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="estrella_fuerte" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                             From="0" To="1.5" Duration="0:0:0.1" BeginTime="0:0:0.25" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Name="sbAtaqueFlojo">
            <DoubleAnimation Storyboard.TargetName="cvUnown" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                             From="0" To="20" Duration="0:0:0.15" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="brazo" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="0" To="-70" Duration="0:0:0.15" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="sombra_brazo" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="0" To="-70" Duration="0:0:0.15" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="estrella_floja" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.8" Duration="0:0:0.1" BeginTime="0:0:0.15" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Name="sbCansado">
            <DoubleAnimation Storyboard.TargetName="cvUnown" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                             To="25" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="cvUnown" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                             From="-2" To="2" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Name="sbDescansando">
            <DoubleAnimation Storyboard.TargetName="cvUnown" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                             From="1" To="1.04" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="cvUnown" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                             From="1" To="0.96" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="texto_zzz" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="texto_zzz" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                             From="0" To="-40" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Name="sbDerrota">
            <DoubleAnimation Storyboard.TargetName="cvUnown" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                             To="150" Duration="0:0:1" />
            <DoubleAnimation Storyboard.TargetName="cvUnown" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:1" />
        </Storyboard>

        <Storyboard x:Name="sbRevivir">
            <DoubleAnimation Storyboard.TargetName="cvUnown" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                             To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="cvUnown" Storyboard.TargetProperty="Opacity"
                             From="0.2" To="1" Duration="0:0:0.25" RepeatBehavior="3x" />
        </Storyboard>

        <Storyboard x:Name="sbDefensa">
            <DoubleAnimation Storyboard.TargetName="escudo" Storyboard.TargetProperty="Opacity"
                             To="0.8" Duration="0:0:0.3" />
        </Storyboard>
        <Storyboard x:Name="sbDefensaOut">
            <DoubleAnimation Storyboard.TargetName="escudo" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.5" />
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="Transparent" x:Name="gridGeneral">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="imFondo" Grid.RowSpan="4" Grid.ColumnSpan="3" Source="AssetsUnownOVG/fondo.jpg" Stretch="UniformToFill" Visibility="Visible" />

        <Image x:Name="imIconoVida" Source="AssetsUnownOVG/corazon.png" Grid.Row="0" Grid.Column="0" Margin="5"/>
        <Image x:Name="imIconoEnergia" Source="AssetsUnownOVG/energia.png" Grid.Row="1" Grid.Column="0" Margin="5"/>

        <ProgressBar x:Name="pbVida" Grid.Row="0" Grid.Column="1" Value="100" Maximum="100" Foreground="Red" Margin="5" VerticalAlignment="Center" Height="20"/>
        <ProgressBar x:Name="pbEnergia" Grid.Row="1" Grid.Column="1" Value="100" Maximum="100" Foreground="Yellow" Margin="5" VerticalAlignment="Center" Height="20"/>

        <Image x:Name="imPocionVida" Source="AssetsUnownOVG/red-potion.png" Grid.Row="0" Grid.Column="2" Margin="5" Visibility="Visible" PointerReleased="usarPocionVida"/>
        <Image x:Name="imPocionEnergia" Source="AssetsUnownOVG/yellow-potion.png" Grid.Row="1" Grid.Column="2" Margin="5" Visibility="Visible" PointerReleased="usarPocionEnergia"/>

        <Viewbox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
            <Canvas x:Name="cvUnown" Width="500" Height="500" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <CompositeTransform/>
                </Canvas.RenderTransform>

