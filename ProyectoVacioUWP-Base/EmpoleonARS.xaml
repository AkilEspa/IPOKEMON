    <!-- ==== AQUÍ VA EL GRID ==== -->
    <Grid>

        <!-- Fondo a pantalla completa -->
        <Image x:Name="image" Source="AssetsE/glaciar.jpg"
               Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5" >
            <Image.RenderTransform>
                <CompositeTransform/>
            </Image.RenderTransform>
        </Image>

        <!-- Grid del HUD -->
        <Grid Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="70*"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22*"/>
                <ColumnDefinition Width="257*"/>
                <ColumnDefinition Width="21*"/>
            </Grid.ColumnDefinitions>

            <!-- Icono corazón (vida) -->
            <Image x:Name="imgCorazon"
                   Grid.Row="0" Grid.Column="0"
                   Source="AssetsE/corazon.png"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

            <!-- Barra de vida -->
            <ProgressBar x:Name="pbVida"
                         Grid.Row="0" Grid.Column="1"
                         Minimum="0" Maximum="100"
                         Value="80"
                         Height="30"
                         Background="DarkRed"
                         Foreground="Red" />

            <!-- Poción roja (vida) -->
            <Image x:Name="imgPocionRoja"
                   Grid.Row="0" Grid.Column="2"
                   Source="AssetsE/red-potion.png"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   PointerPressed="imgPocionRoja_PointerPressed" />

            <!-- Icono energía -->
            <Image x:Name="imgEnergia"
                   Grid.Row="1" Grid.Column="0"
                   Source="AssetsE/energia.png"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

