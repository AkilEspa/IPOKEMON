        <Image x:Name="ImagenEscudo" Source="AssetsPVA/Escudo.png" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="100" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <Image x:Name="ImagenDormido" Source="AssetsPVA/dormido.png" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="200">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <Image x:Name="ImagenAtaqueFuerte" Source="AssetsPVA/ataque_fuerte.png" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="200">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,20,0,0">

            <TextBlock x:Name="txtNombre" Text="Rotom" FontSize="26" FontWeight="Bold" Foreground="White" Margin="35,0,0,10" Visibility="Collapsed"/>

            <StackPanel x:Name="panelVida" Orientation="Horizontal" Margin="0,5,0,5" Visibility="Collapsed">
                <Image Source="AssetsPVA/corazon.png" Width="25" Height="25" Stretch="Uniform"/>
                <ProgressBar x:Name="pbVida" Value="100" Maximum="100" Width="150" Height="20" Foreground="#E51414" Background="DarkGray" Margin="10,0,0,0" />
            </StackPanel>

            <StackPanel x:Name="panelEnergia" Orientation="Horizontal" Margin="0,5,0,5" Visibility="Collapsed">
                <Image Source="AssetsPVA/energia.png" Width="25" Height="25" Stretch="Uniform"/>
                <ProgressBar x:Name="pbEnergia" Value="100" Maximum="100" Width="150" Height="20" Foreground="#FFD700" Background="DarkGray" Margin="10,0,0,0" />
            </StackPanel>

        </StackPanel>

        <MediaElement x:Name="sonidoAtaque" 
                      Source="ms-appx:///AssetsPVA/rotom_cry.mp4" 
                      AutoPlay="False" 
                      Visibility="Collapsed"/>

        <MediaElement x:Name="sonidoAtaqueFuerte" 
                      Source="ms-appx:///AssetsPVA/rotom_cry_fuerte.mp4" 
                      AutoPlay="False" 
                      Visibility="Collapsed"/>
    </Grid>
</UserControl>