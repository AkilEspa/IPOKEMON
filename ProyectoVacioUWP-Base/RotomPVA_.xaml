<UserControl
    x:Class="ProyectoVacioUWP_Base.RotomXYZ"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="ProyectoVacioUWP_Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="500"
    d:DesignWidth="500">

    <UserControl.Resources>
        
        <Storyboard x:Key="AniIdle">
            <DoubleAnimation
                Storyboard.TargetName="RotomContenedor"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)"
                From="-8"
                To="8"
                Duration="0:0:3.5"
                AutoReverse="True"
                RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="RotomContenedor"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)"
                From="-12"
                To="12"
                Duration="0:0:2.7"
                AutoReverse="True"
                RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        
        <Storyboard x:Key="AtaqueFlojo">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RotomContenedor" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-30"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="30"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="AtaqueFuerte">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RotomContenedor" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-30"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="30"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="ImagenAtaqueFuerte" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="ImagenAtaqueFuerte" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0" To="2.5" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetName="ImagenAtaqueFuerte" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0" To="2.5" Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Key="Herido">
            <ColorAnimation Storyboard.TargetName="Int_izq" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#FFE51414" Duration="0:0:0.5" />
            <ColorAnimation Storyboard.TargetName="Int_der" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#FFE51414" Duration="0:0:0.5" />
        </Storyboard>

        <Storyboard x:Key="NoHerido">
            <ColorAnimation Storyboard.TargetName="Int_izq" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#FF2B6EAF" Duration="0:0:0.5" />
            <ColorAnimation Storyboard.TargetName="Int_der" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#FF2D6EAE" Duration="0:0:0.5" />
        </Storyboard>

        <Storyboard x:Key="Cansado" RepeatBehavior="Forever" AutoReverse="True">

            <ColorAnimation Storyboard.TargetName="C_ext" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="#FF202020" 
                            Duration="0:0:1.5">
                <ColorAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </ColorAnimation.EasingFunction>
            </ColorAnimation>

            <ColorAnimation Storyboard.TargetName="C_int" 
                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" 
                            To="#FF303030" 
                            Duration="0:0:1.5">
                <ColorAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </ColorAnimation.EasingFunction>
            </ColorAnimation>

        </Storyboard>

        <Storyboard x:Key="Protegido">
            <DoubleAnimation Storyboard.TargetName="ImagenEscudo" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.5" />
        </Storyboard>

        <Storyboard x:Key="SinEscudo">
            <DoubleAnimation Storyboard.TargetName="ImagenEscudo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5" />
        </Storyboard>

        <Storyboard x:Key="Dormido" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="ImagenDormido" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:1" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Canvas x:Name="RotomContenedor" RenderTransformOrigin="0.5,0.5" Width="600" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Canvas.RenderTransform>

