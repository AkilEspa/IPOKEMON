<UserControl
    x:Class="ProyectoVacioUWP_Base.GengarMBGCS"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProyectoVacioUWP_Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <UserControl.Resources>

        <!-- ANIMACION IDDLE -->
        <Storyboard x:Name="respirar" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="PokemonCanvas"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                From="1" To="1.05" Duration="0:0:1"/>

            <DoubleAnimation
                Storyboard.TargetName="PokemonCanvas"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                From="1" To="1.05" Duration="0:0:1"/>
        </Storyboard>

        <!-- ATAQUE FUERTE -->
        <Storyboard x:Name="ataqueGengar" FillBehavior="Stop">
            <!-- escala -->
            <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="bolaAtaque"
        Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1.2"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2.3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="bolaAtaque"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1.2"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2.3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- opacidad -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="bolaAtaque"
                Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2.3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- brazos -->
            <DoubleAnimationUsingKeyFrames 
                Storyboard.TargetName="BrazoDe" 
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)">
                <DiscreteDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="00:00:00.5" Value="-13.208"/>
                <DiscreteDoubleKeyFrame KeyTime="00:00:01" Value="-30.23"/>
                <DiscreteDoubleKeyFrame KeyTime="00:00:01.7" Value="-17.046"/>
                <DiscreteDoubleKeyFrame KeyTime="00:00:02.3" Value="-7.517"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames 
                Storyboard.TargetName="BrazoIz" 
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)">
                <DiscreteDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="00:00:00.5" Value="13.208"/>
                <DiscreteDoubleKeyFrame KeyTime="00:00:01" Value="30.23"/>
                <DiscreteDoubleKeyFrame KeyTime="00:00:01.7" Value="17.046"/>
                <DiscreteDoubleKeyFrame KeyTime="00:00:02.3" Value="7.517"/>
            </DoubleAnimationUsingKeyFrames>

        </Storyboard>

        <!-- ATAQUE FLOJO -->
        <Storyboard x:Name="moverLengua" RepeatBehavior="4x">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Lengua"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="-7.869"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.5" Value="13.581"/>
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="-9.176"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- DEFENSA -->
        <Storyboard x:Name="animDefensa" FillBehavior="HoldEnd">
            <!-- escudo -->
            <DoubleAnimation
                Storyboard.TargetName="Escudo"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.5" 
                AutoReverse="False"/>

            <!-- pulso del cuerpo -->
            <DoubleAnimation
                Storyboard.TargetName="PokemonCanvas"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                To="1.2" Duration="0:0:0.2" AutoReverse="True"/>

            <DoubleAnimation
                Storyboard.TargetName="PokemonCanvas"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                To="1.2" Duration="0:0:0.2" AutoReverse="True"/>
        </Storyboard>

        <!-- DESCANSAR -->
        <Storyboard x:Name="animDescansar" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="PokemonCanvas"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0.6"
                Duration="0:0:1"/>
        </Storyboard>
        
        <!-- HERIDO -->
        <Storyboard x:Name="animHerido">
            <!-- Ojo Izquierdo -->
            <DoubleAnimation 
                Storyboard.TargetName="OjoIzq" 
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                To="-15" 
                Duration="0:0:0.3"/>
            <DoubleAnimation 
                Storyboard.TargetName="OjoIzq" 
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" 
                To="3" 
                Duration="0:0:0.3"/>
            <ColorAnimation
                Storyboard.TargetName="OjoIzq"
                Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                From="Red" To="Purple" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
            <!-- Ojo Derecho -->
            <DoubleAnimation 
                Storyboard.TargetName="OjoDer" 
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                To="15" 
                Duration="0:0:0.3"/>
            <DoubleAnimation 
                Storyboard.TargetName="OjoDer" 
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" 
                To="3" 
                Duration="0:0:0.3"/>
            <ColorAnimation
                Storyboard.TargetName="OjoDer"
                Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                From="Red" To="Purple" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
            <!-- Temblor del cuerpo -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="PokemonCanvas"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="-5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-3"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="3"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!--CANSADO-->
        <Storyboard x:Name="animCansado">
            <!-- ojos -->
            <DoubleAnimation 
                Storyboard.TargetName="OjoIzq" 
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                To="-15" 
                Duration="0:0:0.3"/>
            <DoubleAnimation 
                Storyboard.TargetName="OjoIzq" 
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" 
                To="3" 
                Duration="0:0:0.3"/>
            <DoubleAnimation 
                Storyboard.TargetName="OjoDer" 
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" 
                To="15" 
                Duration="0:0:0.3"/>
            <DoubleAnimation 
                Storyboard.TargetName="OjoDer" 
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" 
                To="3" 
                Duration="0:0:0.3"/>
            <!-- sudor -->
            <DoubleAnimation 
                Storyboard.TargetName="sudor1" 
                Storyboard.TargetProperty="Opacity" 
                To="1" 
                Duration="0:0:0.3"/>
            <DoubleAnimation 
                Storyboard.TargetName="sudor2" 
                Storyboard.TargetProperty="Opacity" 
                To="1" 
                Duration="0:0:0.3" 
                BeginTime="0:0:0.1"/>
        </Storyboard>

        <!-- DERROTA -->
        <Storyboard x:Name="animDerrota">
            <DoubleAnimation
                Storyboard.TargetName="PokemonCanvas"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)"
                To="90" Duration="0:0:0.5"/>

            <DoubleAnimation
                Storyboard.TargetName="PokemonCanvas"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:1"/>
        </Storyboard>

    </UserControl.Resources>

    <!-- GRID -->
    <Grid x:Name="gridGeneral">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <!-- FONDO -->
        <Image
            x:Name="imFondo"
            Grid.RowSpan="4"
            Grid.ColumnSpan="3"
            Source="/AssetsGengarMBGCS/mansion.png"
            Stretch="UniformToFill"/>

        <!-- VIDA -->
        <Image Grid.Row="0" Grid.Column="0"
               Source="AssetsGengarMBGCS/corazon.png"
               Height="40"/>

        <ProgressBar x:Name="pbHealth"
                     Grid.Row="0"
                     Grid.Column="1"
                     Maximum="100"
                     Value="50"
                     Foreground="Red"
                     Height="30"/>
        
        <Image x:Name="imRedPotion" 
               Grid.Row="0" 
               Grid.Column="2" 
               Source="AssetsGengarMBGCS/red-potion.png" 
               Height="40" 
               PointerReleased="useRedPotion"/>

        <!-- ENERGÍA -->
        <Image Grid.Row="1" Grid.Column="0"
               Source="AssetsGengarMBGCS/energia.png"
               Height="40"/>

        <ProgressBar x:Name="pbEnergy"
                     Grid.Row="1"
                     Grid.Column="1"
                     Maximum="100"
                     Value="50"
                     Foreground="Yellow"
                     Height="30"/>
        
        <Image x:Name="imYellowPotion" 
               Grid.Row="1" 
               Grid.Column="2" 
               Source="AssetsGengarMBGCS/yellow-potion.png" 
               Height="40"/>

