<Page
    x:Class="ProyectoVacioUWP_Base.AcercaDePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProyectoVacioUWP_Base"
    Background="#121212">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" Background="Transparent" DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
            <AppBarButton x:Name="BtnIdioma" Icon="World" Label="English" Click="BtnIdioma_Click" Foreground="White"/>
        </CommandBar>

        <TextBlock x:Name="TxtTitulo" Grid.Row="1" Text="CAPTURA LOS DESARROLLADORES" 
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="White" Margin="0,10,0,10" FontFamily="Consolas" FontWeight="Bold" FontSize="36"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <GridView x:Name="ContenedorPrincipal" HorizontalAlignment="Center" VerticalAlignment="Center" SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <StackPanel x:Name="ContenedorDev1" PointerPressed="CapturarDev_PointerPressed" Tag="José Félix" Margin="15" Width="220" Height="300">
                    <Viewbox x:Name="VB1" Height="180" Stretch="Uniform">
                        <local:TorchicJFBR x:Name="PokemonJoseFelix"/>
                    </Viewbox>
                    <TextBlock Text="José Félix" HorizontalAlignment="Center" Foreground="Cyan" FontSize="18" Margin="0,10"/>
                    <Grid Height="60">
                        <Image x:Name="Ball1" Source="https://cdn-icons-png.flaticon.com/512/188/188918.png" 
                               Width="50" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <CompositeTransform/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="ContenedorDev2" PointerPressed="CapturarDev_PointerPressed" Tag="Darío" Margin="15" Width="220" Height="300">
                    <Viewbox x:Name="VB2" Height="180" Stretch="Uniform">
                        <local:ComputerrorDLM x:Name="PokemonDario" />
                    </Viewbox>
                    <TextBlock Text="Darío" HorizontalAlignment="Center" Foreground="Cyan" FontSize="18" Margin="0,10"/>
                    <Grid Height="60">
                        <Image x:Name="Ball2" Source="https://cdn-icons-png.flaticon.com/512/188/188918.png" 
                               Width="50" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <CompositeTransform/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="ContenedorDev3" PointerPressed="CapturarDev_PointerPressed" Tag="Akil" Margin="15" Width="220" Height="300">
                    <Viewbox x:Name="VB3" Height="180" Stretch="Uniform">
                        <local:DittoAEJ x:Name="PokemonAkil" />
                    </Viewbox>
                    <TextBlock Text="Akil" HorizontalAlignment="Center" Foreground="Cyan" FontSize="18" Margin="0,10"/>
                    <Grid Height="60">
                        <Image x:Name="Ball3" Source="https://cdn-icons-png.flaticon.com/512/188/188918.png" 
                               Width="50" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <CompositeTransform/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </StackPanel>
            </GridView>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#66000000" Padding="15">
            <TextBlock x:Name="TxtLog" Text="HAZ CLICK PARA ATRAPARLOS..." 
                       HorizontalAlignment="Center" TextAlignment="Center" Foreground="Yellow" FontSize="16" FontFamily="Consolas"/>
        </Border>
    </Grid>
</Page>