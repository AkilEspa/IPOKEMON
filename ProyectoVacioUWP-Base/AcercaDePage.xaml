<Page
    x:Class="ProyectoVacioUWP_Base.AcercaDePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProyectoVacioUWP_Base"
    Background="#121212">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">
                <!-- Estado para pantallas estrechas (Móviles/Ventana pequeña) -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TxtTitulo.FontSize" Value="30"/>
                        <Setter Target="TxtTitulo.Margin" Value="10,20,10,0"/>
                        <Setter Target="MainScroll.VerticalScrollBarVisibility" Value="Auto"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- Estado para pantallas anchas (PC/Tablet) -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TxtTitulo.FontSize" Value="50"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título Adaptable -->
        <TextBlock x:Name="TxtTitulo" Grid.Row="0" Text="CAPTURA LOS DESARROLLADORES" 
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="White" Margin="0,40,0,20" FontFamily="Consolas" FontWeight="Bold"/>

        <!-- Contenedor con Scroll y WrapGrid -->
        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
            <ItemsControl HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- El ItemsWrapGrid hace que los elementos bajen a la siguiente línea si no caben -->
                        <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center" MaximumRowsOrColumns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- Dev 1 -->
                <StackPanel x:Name="ContenedorDev1" PointerPressed="CapturarDev_PointerPressed" Tag="José Felíx" Margin="20">
                    <Viewbox Width="180" Height="180">
                        <local:TorchicJFBR x:Name="PokemonJoseFelix"/>
                    </Viewbox>
                    <TextBlock Text="José Félix" HorizontalAlignment="Center" Foreground="Cyan" FontSize="20" Margin="0,10"/>
                    <Image x:Name="Ball1" Source="https://cdn-icons-png.flaticon.com/512/188/188918.png" 
                           Width="60" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <CompositeTransform/>
                        </Image.RenderTransform>
                    </Image>
                </StackPanel>

                <!-- Dev 2 -->
                <StackPanel x:Name="ContenedorDev2" PointerPressed="CapturarDev_PointerPressed" Tag="Darío" Margin="20">
                    <Viewbox Width="180" Height="180">
                        <local:ComputerrorDLM x:Name="PokemonDario" />
                    </Viewbox>
                    <TextBlock Text="Darío" HorizontalAlignment="Center" Foreground="Cyan" FontSize="20" Margin="0,10"/>
                    <Image x:Name="Ball2" Source="https://cdn-icons-png.flaticon.com/512/188/188918.png" 
                           Width="60" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <CompositeTransform/>
                        </Image.RenderTransform>
                    </Image>
                </StackPanel>

                <!-- Dev 3 -->
                <StackPanel x:Name="ContenedorDev3" PointerPressed="CapturarDev_PointerPressed" Tag="Akil" Margin="20">
                    <Viewbox Width="180" Height="180">
                        <local:DittoAEJ x:Name="PokemonAkil"/>
                    </Viewbox>
                    <TextBlock Text="Akil" HorizontalAlignment="Center" Foreground="Cyan" FontSize="20" Margin="0,10"/>
                    <Image x:Name="Ball3" Source="https://cdn-icons-png.flaticon.com/512/188/188918.png" 
                           Width="60" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <CompositeTransform/>
                        </Image.RenderTransform>
                    </Image>
                </StackPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Barra de Log Adaptable -->
        <Border Grid.Row="2" Background="#44000000" Padding="10">
            <TextBlock x:Name="TxtLog" Text="HAZ CLICK EN UN DESARROLLADOR PARA ATRAPARLO..." 
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="Yellow" FontSize="18" FontFamily="Consolas"/>
        </Border>
    </Grid>
</Page>